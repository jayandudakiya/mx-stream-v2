<?xml version="1.0" encoding="utf-8"?>
<!-- OrcaBox mark. Foreground + background come from the OrcaBox icon set, so
     the cream background is the artwork's own and the two blend into one image
     under whatever mask a launcher applies. The monochrome layer is what
     Android 13+ themed icons use; it falls back to the colour layers below 33. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_fg" />
    <monochrome android:drawable="@mipmap/ic_launcher_classic_fg" />
</adaptive-icon>
