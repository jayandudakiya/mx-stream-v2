<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Same one-icon rule as src/debug: the Flutter-tool MAIN+LAUNCHER filter
         stays on MainActivity in the main manifest, so the aliases are disabled
         here to keep a profile install from showing two identical icons. -->
    <application>
        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="false"
            tools:replace="android:enabled" />
        <activity-alias
            android:name=".MainActivityClassic"
            android:enabled="false"
            tools:replace="android:enabled" />
    </application>
</manifest>
