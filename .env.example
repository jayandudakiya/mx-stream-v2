# OrcaBox build configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Every key here is read at COMPILE time via String.fromEnvironment, so a build
# must pass the file explicitly:
#
#   fvm flutter run   --dart-define-from-file=.env
#   fvm flutter build apk --release --dart-define-from-file=.env
#   fvm flutter test  --dart-define-from-file=.env
#
# .vscode/launch.json already passes it for every debug/profile target.
# A missing key does not crash the app: the feature that needs it degrades
# (see lib/core/environment.dart), which is why the guard tests in
# test/core/environment_dart_define_test.dart skip rather than fail without it.
#
# Server-side secrets (the Supabase edge function) do NOT belong here — they go
# in `supabase secrets set`; see supabase/.env.example.

# ── Backend ──────────────────────────────────────────────────────────────────
# Master switch for everything that needs the Supabase backend: sign in / sign
# up / profile, cross-device library sync, TV pairing (account AND the tracker
# QR relay), Watch Party, and cloud backup/restore. Unset (the default) the app
# is LOCAL-ONLY — Supabase is never initialized, every one of those screens is
# hidden, and My List / watch history / categories live purely in Hive.
# Set to true once the backend is live to bring the whole flow back.
# See lib/core/app_features.dart.
# CLOUD_ACCOUNTS=true

# Supabase project URL and anon (public) key. Only read when CLOUD_ACCOUNTS is
# true. Safe to ship in a client build — row-level security is what protects
# the data, not the key. NEVER put the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Metadata ─────────────────────────────────────────────────────────────────
# TMDB v3 API key: 32 lowercase hex characters, from
# https://www.themoviedb.org/settings/api — the "API Key (v3 auth)" value, NOT
# the v4 bearer token. Sole source for movie/TV metadata.
TMDB_API_KEY=00000000000000000000000000000000

# ── Trackers ─────────────────────────────────────────────────────────────────
# AniList OAuth client, from https://anilist.co/settings/developer
# Sole source for anime metadata, and the anime list tracker.
# The redirect URI on the AniList app must be exactly:  orcabox://anilist-auth
ANILIST_CLIENT_ID=12345
# The APP does not read this — the mobile flow is the implicit grant, which
# returns the token in the URL fragment with no secret. It is required by the
# TV web-login exchange, which runs in the pair-tv edge function; set it there
# with `supabase secrets set ANILIST_CLIENT_SECRET=...`.
ANILIST_CLIENT_SECRET=

# MyAnimeList OAuth2 client id, from https://myanimelist.net/apiconfig
# PKCE (plain) — no client secret. The redirect URI on the MAL app must be
# exactly:  orcabox://mal-auth
# Also used as the X-MAL-CLIENT-ID header for MAL relations/recommendations.
MAL_CLIENT_ID=

# ── Web ──────────────────────────────────────────────────────────────────────
# Base URL of the deployed site. Feeds the share "open" page, the TV pairing
# page, the tracker browser-login page and the password-reset landing:
#   $SITE_BASE_URL/open/   $SITE_BASE_URL/pair/
#   $SITE_BASE_URL/tv-connect/   $SITE_BASE_URL/
# No trailing slash. Must also be allow-listed as a Supabase auth redirect URL.
SITE_BASE_URL=https://your-site.example

# ── Distribution ─────────────────────────────────────────────────────────────
# The app's own GitHub repo as `owner/name`. Drives the in-app updater, the
# announcements feed, the About screen links, the contributors list and the
# downloadable subtitle fonts — so it must always name a repo you own.
APP_REPO=owner/repo

# ── Subtitles ────────────────────────────────────────────────────────────────
# SubDL API key, from https://subdl.com/panel/api — a second subtitle source.
# Empty disables that tier; OpenSubtitles (key entered by the user in Settings)
# is unaffected.
SUBDL_API_KEY=

# ── Brand ────────────────────────────────────────────────────────────────────
# Display name shown wherever the UI names the app.
APP_NAME=OrcaBox
# Pre-boot fallback only — the running version is read from PackageInfo at
# startup, so this never goes stale in Settings/About.
APP_VERSION=1.0.1

# ── Community ────────────────────────────────────────────────────────────────
# Discord Rich Presence application id, from
# https://discord.com/developers/applications → General Information.
# Empty keeps Rich Presence off. The name Discord shows next to what the user
# is watching comes from THIS application, not from APP_NAME.
DISCORD_APPLICATION_ID=

# Community Discord invite. Accepts a full https link, `discord.gg/<code>`, or
# a bare `<code>`. Empty hides every Discord entry point in the UI.
DISCORD_INVITE_URL=

# Official Telegram channel URL. Empty hides every Telegram entry point.
TELEGRAM_URL=

# ── Support / donations ──────────────────────────────────────────────────────
# Payout endpoints for the Support screen. Each option hides itself while its
# own value is blank, and Settings hides the "Support the app" entry point
# entirely when all three are empty — so a fork never collects on your behalf,
# and you never collect on the upstream author's.
# Buy Me a Coffee profile URL.
DONATE_BMC_URL=
# PayPal.me or a paypal.com donate link.
DONATE_PAYPAL_URL=
# UPI VPA for India, e.g. `name@bank` — an id, not a URL.
DONATE_UPI_ID=
