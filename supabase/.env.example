# Secrets for the `pair-tv` Supabase edge function (TV <-> phone pairing and the
# browser tracker-login exchange). These are SERVER-side — they must never be
# added to the app's `.env`, which is compiled into the shipped binary.
#
# Set them with:
#   supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform; you
# do not set those yourself.

# AniList — same client as the app's ANILIST_CLIENT_ID. The TV web-login page
# cannot use the implicit grant over an https redirect, so the function does an
# authorization_code exchange here, which needs the client secret.
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# MyAnimeList — same client as the app's MAL_CLIENT_ID. PKCE, no secret; the
# exchange lives here only because MAL blocks browser CORS.
MAL_CLIENT_ID=

# Simkl — only needed while the `simkl` branch of the exchange is still live.
# The app no longer ships a Simkl tracker (lib/core/tracker/simkl_service.dart
# was removed), so these can stay empty and that branch will simply fail.
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
