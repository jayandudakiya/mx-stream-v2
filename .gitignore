# Internal docs & scratch — not part of the shipped app
/docs/
release-v*/
banner/
poster/
secrets.json
*.env.json
tmdb.env.json

# Aniyomi loader test fixture APK — on-device validated instead of committed
android/app/src/test/resources/aniyomi/*.apk

# Supabase local env & temp (service_role key is secret — never commit)
.env
.env.*
*.local
supabase/.env
supabase/.temp/
# ...but the value-free templates DO ship, so a fresh clone knows what to fill
# in. `.env.*` above would otherwise swallow them.
!.env.example
!supabase/.env.example

# FVM Version Cache
.fvm/

app-pre-releases-v

flows